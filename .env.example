# Depois de preencher os valores reais aqui, va para app.render.com e cole
# cada uma dessas linhas nas variaveis de ambiente do seu servico.

# Token de API da IronPay (Painel da IronPay -> Configuracoes -> API)
IRONPAY_API_KEY=

# Deixe estes dois em branco. Depois que o site estiver no ar, va em
# SEUSITE.onrender.com/setup e clique no botao - ele preenche isso sozinho.
IRONPAY_PRODUCT_HASH=
IRONPAY_OFFER_HASH=

# Preco cobrado por arquivo editado, em centavos (990 = R$ 9,90)
PRICE_CENTS=990
